# Streamrip Web Interface Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_QUEUE_SIZE=1000

# Streamrip Configuration
STREAMRIP_CONFIG_PATH=/app/config/config.toml

# Security (for production)
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Database (if using external database)
DATABASE_URL=sqlite:///app/config/streamrip_web.db

# Redis (for caching and sessions)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/streamrip-web.log

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# File Upload Limits
MAX_UPLOAD_SIZE=100MB
MAX_URLS_PER_BATCH=100

# Download Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
